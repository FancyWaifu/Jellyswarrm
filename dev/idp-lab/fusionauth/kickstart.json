{
  "variables": {
    "apiKey": "dev-lab-fusionauth-admin-key-0123456789abcdef0123456789abcdef",
    "asymmetricKeyId": "#{UUID()}",
    "applicationId": "e9fdb985-9173-4e01-9d73-ac2d60d1dc8e",
    "clientSecret": "jellyswarrm-fusionauth-secret",
    "defaultTenantId": "d7d09513-a3f5-401c-9685-34ab6c552453",
    "userEmail": "testuser@example.com",
    "userPassword": "Password1!",
    "userId": "00000000-0000-0000-0000-111111111111"
  },
  "apiKeys": [
    {
      "key": "#{apiKey}",
      "description": "Unrestricted lab admin API key"
    }
  ],
  "requests": [
    {
      "method": "PATCH",
      "url": "/api/tenant/#{defaultTenantId}",
      "body": {
        "tenant": {
          "issuer": "http://fusionauth:9011"
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/key/generate/#{asymmetricKeyId}",
      "body": {
        "key": {
          "algorithm": "RS256",
          "name": "Jellyswarrm id_token signing key",
          "length": 2048
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/application/#{applicationId}",
      "body": {
        "application": {
          "name": "Jellyswarrm",
          "oauthConfiguration": {
            "authorizedRedirectURLs": [
              "http://localhost:3000/sso/callback"
            ],
            "logoutURL": "http://localhost:3000/",
            "clientSecret": "#{clientSecret}",
            "enabledGrants": [
              "authorization_code",
              "refresh_token"
            ],
            "clientAuthenticationPolicy": "Required",
            "proofKeyForCodeExchangePolicy": "NotRequired",
            "generateRefreshTokens": true,
            "requireRegistration": true
          },
          "jwtConfiguration": {
            "enabled": true,
            "accessTokenKeyId": "#{asymmetricKeyId}",
            "idTokenKeyId": "#{asymmetricKeyId}"
          },
          "loginConfiguration": {
            "requireAuthentication": false
          }
        }
      }
    },
    {
      "method": "POST",
      "url": "/api/user/registration/#{userId}",
      "body": {
        "skipRegistrationVerification": true,
        "user": {
          "email": "#{userEmail}",
          "password": "#{userPassword}",
          "firstName": "Test",
          "lastName": "User",
          "verified": true
        },
        "registration": {
          "applicationId": "#{applicationId}",
          "verified": true
        }
      }
    }
  ]
}
